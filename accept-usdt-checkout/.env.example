# Your workspace's API key (Dashboard → Developers → API keys). Use a TEST workspace first.
VALTU_KEY_FILE=./valtu-server.json
# Webhook verification key (Dashboard → Developers → Webhooks), or from `npx valtu-wallet-kit webhooks listen`.
VALTU_WEBHOOK_PUBLIC_KEY=
# Where this app runs (used for the return links after payment).
PUBLIC_URL=http://localhost:3000
PORT=3000
